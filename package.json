{
  "name": "jarvis-personal-assistant",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A personal assistant with local AI, voice, memory and tasks.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:windows": "npm run build && electron-builder --win portable --x64 --publish never",
    "package:android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "^6.0.0"
  },
  "main": "desktop/main.cjs",
  "author": "JARVIS project"
}
